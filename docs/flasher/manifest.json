{
  "name": "Wisp Node",
  "version": "0.0.0",
  "home_assistant_domain": "wisp",
  "new_install_prompt_erase": true,
  "builds": [
    {
      "chipFamily": "ESP32-C3",
      "improv": true,
      "parts": [
